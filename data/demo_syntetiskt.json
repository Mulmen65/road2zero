    {
      "id": "USER",
      "title": "Användarens projektuppgifter",
      "author": "Projektets användare",
      "year": "2026",
      "url": "",
      "locator": "",
      "kind": "Projektunderlag",
      "note": "SMT:s område och 4 000 bostäder är användarens avgränsning. Egna senare indata är inte externt verifierade."
    },
    {
      "id": "ASSUMPTION",
      "title": "Road2Zero – uttryckliga arbetsantaganden",
      "author": "",
      "year": "2026",
      "url": "",
      "locator": "",
      "kind": "Antagande",
      "note": "Proportionering från hela FÖP, fyra lika stora etapper och arbetsårtal ska bekräftas av SMT."
    },
    {
      "id": "FOP2025",
      "title": "Översiktsplan för Jägersro – granskningshandling",
      "author": "Malmö stad",
      "year": "2025",
      "url": "https://malmo.se/download/18.50574bcf196ed960a55a894/1758803712161/F%C3%96P2040_J%C3%A4gersro_granskningshandling_tg.pdf",
      "locator": "s. 14–15, program och park; s. 20, genomförande",
      "kind": "Projektunderlag",
      "note": "Hela planområdet: 4 300 bostäder, 440 000 m² bostads-BTA, 8 900 invånare. Detta är inte fastställda SMT-mängder. Park >5 ha; 50 000 m² används som preliminärt nedre arbetsvärde."
    },
    {
      "id": "STMX",
      "title": "Klimatmodell CO2e-budget, Avatar-MFF.stmx",
      "author": "Tillhandahållen Jägersromodell",
      "year": "",
      "url": "",
      "locator": "Exploatering.Total_yta_stadsdel_(m2)",
      "kind": "Äldre modell",
      "note": "Sparat värde 410 000 m²; bekräfta fastighetsarean. SHA256: 4d30512e1048c8e6d5b16681fbd1410b1fc843af8c5096e4f4633534c4699c59. Äldre Mat-parametrar har delvis motstridiga enhetsnamn."
    },
    {
      "id": "OCEAN2026",
      "title": "Oceanhamnen Etapp 1, 2, 3 & 4 2026-08-28-underlag.xlsx",
      "author": "",
      "year": "",
      "url": "",
      "locator": "Schablonvärden",
      "kind": "Äldre modell",
      "note": "Spårbar återanvändning av exportvärden. Ursprungskällor är delvis breda eller ofullständiga. Inga värden här är projektspecifikt verifierade för SMT."
    },
    {
      "id": "MANUAL3",
      "title": "Klimatanalys 3.0 – tillhandahållen manual",
      "author": "",
      "year": "",
      "url": "",
      "locator": "",
      "kind": "Modellbeskrivning",
      "note": "Kategorier och objektfält. Road2Zero använder manuell area och separat redovisning av inventering, jämförelse och kollager."
    },
    {
      "id": "IPCC2006",
      "title": "2006 IPCC Guidelines, Volume 4, Chapter 2",
      "author": "IPCC",
      "year": "2006",
      "url": "https://www.ipcc-nggip.iges.or.jp/public/2006gl/pdf/4_Volume4/V4_02_Ch2_Generic.pdf",
      "locator": "Avsnitt 2.2–2.3; kolpooler och C–CO2-omvandling",
      "kind": "Metod",
      "note": "Metodstöd för kolpooler; modellens lokala markfaktorer måste tillföras och verifieras. Road2Zero är en förenklad projektmodell, inte en fullständig IPCC-inventering."
    },
    {
      "id": "GHG2023",
      "title": "Inventory and Project Accounting: A Comparative Review",
      "author": "GHG Protocol",
      "year": "2023",
      "url": "https://ghgprotocol.org/blog/inventory-and-project-accounting",
      "locator": "",
      "kind": "Metod",
      "note": "Stöd för separat redovisning av inventering och skillnad mot referensalternativ."
    },
    {
      "id": "BOVERKET",
      "title": "Om klimatdeklarationen – byggskedets A1–A5",
      "author": "Boverket",
      "year": "",
      "url": "https://www.boverket.se/sv/klimatdeklaration/om-klimatdeklaration/",
      "locator": "",
      "kind": "Metod",
      "note": "Road2Zero-faktorer kräver uttrycklig omfattning. Hela stadsdelens scenario är inte en juridisk klimatdeklaration."
    },
    {
      "id": "VAGVIS",
      "title": "Vägvis 2.3.0 – projektspecifik export behövs",
      "author": "",
      "year": "",
      "url": "",
